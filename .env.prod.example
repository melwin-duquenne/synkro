# ─── Docker Compose Production Environment ───────────────────────────────────
# Copier ce fichier en .env.prod et remplir les valeurs
# NE JAMAIS COMMITER .env.prod dans le repo

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=synkro
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=synkro

# ─── Symfony Backend ─────────────────────────────────────────────────────────
APP_SECRET=CHANGE_ME_RANDOM_SECRET
JWT_PASSPHRASE=CHANGE_ME_JWT_PASSPHRASE
CORS_ALLOW_ORIGIN='^https://your-domain\.com$'
MAILER_DSN=smtp://your-smtp-server:587
APP_FRONTEND_URL=https://your-domain.com

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-prod-google-client-id
GOOGLE_CLIENT_SECRET=your-prod-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# ─── Frontend (injecté au build Vite) ──────────────────────────────────────
# URL WebSocket vue par le navigateur (passe par le proxy nginx /ws)
VITE_WS_URL=wss://your-domain.com/ws
APP_FRONTEND_URL=https://your-domain.com
