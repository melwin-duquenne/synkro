# ─── Docker Compose Production Environment ───────────────────────────────────
# Copier ce fichier en .env.prod et remplir les valeurs
# NE JAMAIS COMMITER .env.prod dans le repo

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=synkro
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=synkro

# ─── Symfony Backend ─────────────────────────────────────────────────────────
APP_SECRET=CHANGE_ME_RANDOM_SECRET
JWT_PASSPHRASE=CHANGE_ME_JWT_PASSPHRASE
CORS_ALLOW_ORIGIN='^https://your-domain\.com$'
# Brevo : le login = l'email du compte Brevo, encode le '@' en %40 :
#   smtp://test%40gmail.com:TA_CLE_SMTP@smtp-relay.brevo.com:587
MAILER_DSN=smtp://your-smtp-server:587
# Expéditeur des mails de l'app (doit être un expéditeur validé dans Brevo,
# ou une adresse du domaine si tu authentifies synkro.ovh dans Brevo).
MAILER_FROM=noreply@synkro.ovh
APP_FRONTEND_URL=https://your-domain.com

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-prod-google-client-id
GOOGLE_CLIENT_SECRET=your-prod-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# ─── Frontend (injecté au build Vite) ──────────────────────────────────────
# URL WebSocket vue par le navigateur (passe par le proxy nginx /ws)
VITE_WS_URL=wss://your-domain.com/ws
APP_FRONTEND_URL=https://your-domain.com

# ─── Monitoring (Uptime Kuma + Netdata) ─────────────────────────────────
# Mot de passe basic-auth pour les sous-domaines status. et netdata.
MONITORING_HTPASSWD_PASSWORD=CHANGE_ME_MONITORING_PASSWORD

# ─── Wazuh SIEM — relais email via Brevo ────────────────────────────────
# Compte Brevo gratuit > SMTP & API > crée une clé SMTP.
# Valide l'expéditeur (alertes@synkro.ovh) dans Brevo, sinon l'envoi est refusé.
# BREVO_SMTP_USER = ton login Brevo (l'email du compte)
# BREVO_SMTP_KEY  = la clé SMTP générée (PAS le mot de passe du compte)
BREVO_SMTP_USER=your-brevo-login@example.com
BREVO_SMTP_KEY=CHANGE_ME_BREVO_SMTP_KEY

# ─── Wazuh SIEM — alertes via webhook Slack/Discord (canal principal) ────
# Discord : crée un webhook dans le salon, puis AJOUTE /slack à la fin de l'URL.
# Slack   : "Incoming Webhook", colle l'URL telle quelle.
# Laisse vide pour désactiver le webhook.
WAZUH_SLACK_HOOK_URL=
