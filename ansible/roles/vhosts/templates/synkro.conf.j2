# {{ ansible_managed }}

# Redirection HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }} www.{{ domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Vhost principal HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name {{ domain }} www.{{ domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ domain }}/chain.pem;

    include snippets/tls-strong.conf;
    include snippets/security-headers.conf;

    # ModSecurity (si installé)
    {% raw %}
    # modsecurity on;
    # modsecurity_rules_file /etc/nginx/modsec/main.conf;
    {% endraw %}

    # Bloquer scanners et user-agents malveillants
    if ($http_user_agent ~* (sqlmap|nikto|nessus|havij|w3af|nmap|masscan|libwww-perl|wget|curl|python-requests)) {
        return 403;
    }

    # Limiter les méthodes HTTP
    if ($request_method !~ ^(GET|POST|PATCH|PUT|DELETE|HEAD|OPTIONS)$) {
        return 405;
    }

    # Limite le nombre de connexions simultanées par IP
    limit_conn conn_per_ip 30;

    # ─── Frontend Vue ────────────────────────────────────────────────────
    location / {
        proxy_pass http://127.0.0.1:{{ port_frontend }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ─── API générale ────────────────────────────────────────────────────
    location /api/ {
        limit_req zone=api_general burst=50 nodelay;

        proxy_pass http://127.0.0.1:{{ port_frontend }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ─── Login — strict ──────────────────────────────────────────────────
    location = /api/auth/login {
        limit_req zone=api_login burst=3 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:{{ port_frontend }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ─── Register — strict ───────────────────────────────────────────────
    location = /api/auth/register {
        limit_req zone=api_register burst=2 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:{{ port_frontend }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ─── OAuth Google : callback ─────────────────────────────────────────
    # La query du callback Google porte des URLs (scope=…googleapis.com) et un
    # code avec des slashes (code=4/0A…) que l'OWASP CRS prend pour du RFI/SSRF
    # → 403. On repasse le WAF en DetectionOnly UNIQUEMENT sur cette route ;
    # les paramètres sont des jetons OAuth opaques échangés côté serveur avec
    # Google (pas de sink injectable), donc le risque est nul. Le reste du
    # vhost reste protégé en mode bloquant.
    location = /auth/google/callback {
        modsecurity_rules 'SecRuleEngine DetectionOnly';

        proxy_pass http://127.0.0.1:{{ port_frontend }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ─── WebSocket Yjs ───────────────────────────────────────────────────
    location /ws {
        # Le token JWT transite en query string ; on logge l'URI sans query.
        access_log /var/log/nginx/synkro-ws.access.log ws_noquery;
        proxy_pass http://127.0.0.1:{{ port_websocket }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400;
    }

    # Bloquer l'accès aux fichiers sensibles
    location ~ /\.(env|git|htaccess|htpasswd|svn|hg|DS_Store) {
        deny all;
        return 404;
    }

    # Bloquer l'accès aux fichiers de backup
    location ~ ~$ {
        deny all;
        return 404;
    }
}
