# {{ ansible_managed }}

server {
    listen 80;
    listen [::]:80;
    server_name status.{{ domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name status.{{ domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ domain }}/chain.pem;

    include snippets/tls-strong.conf;
    include snippets/security-headers.conf;

    # WAF en DetectionOnly : ModSecurity/OWASP CRS est activé globalement et
    # 403 le trafic /socket.io d'Uptime Kuma (handshake polling + upgrade WS) →
    # le dashboard boucle sur "Lost connection to the socket server" et les 403
    # répétés font bannir l'IP par fail2ban (jail modsecurity). On journalise
    # sans bloquer ; le vhost reste protégé par Basic auth + TLS. Même correctif
    # que le vhost wazuh.
    modsecurity_rules 'SecRuleEngine DetectionOnly';

    auth_basic "Monitoring";
    auth_basic_user_file /etc/nginx/.htpasswd_monitoring;

    # ACME bypass auth
    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
    }

    # WebSocket Kuma
    location /socket.io {
        auth_basic off;
        proxy_pass http://127.0.0.1:{{ port_kuma }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ port_kuma }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
